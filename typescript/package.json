{
  "name": "@lastshoot/sdk",
  "version": "0.1.1",
  "description": "Official TypeScript/JavaScript client for the LastShoot AI product-photography API",
  "license": "MIT",
  "author": "LastShoot",
  "homepage": "https://www.lastshoot.com",
  "keywords": [
    "lastshoot",
    "ai",
    "product photography",
    "virtual try-on",
    "background removal",
    "image generation",
    "api",
    "sdk"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lastshoot-com/lastshoot-sdks.git",
    "directory": "typescript"
  },
  "bugs": {
    "url": "https://github.com/lastshoot-com/lastshoot-sdks/issues"
  }
}
